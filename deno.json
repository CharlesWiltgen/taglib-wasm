{
  "name": "@charlesw/taglib-wasm",
  "version": "2.3.0",
  "description": "TagLib-Wasm is the universal tagging library for TypeScript/JavaScript platforms: Browsers, Node.js, Deno, Bun, Cloudflare Workers, and Electron apps",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./index.ts",
    "./simple": "./simple.ts",
    "./folder": "./folder.ts",
    "./disc-folder": "./disc-folder.ts",
    "./web": "./web.ts",
    "./rating": "./rating.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true
  },
  "publish": {
    "exclude": [
      "lib/",
      "docs/",
      "examples/",
      "scripts/",
      "tools/",
      "tests/",
      "CMakeLists.txt",
      "*.cmake",
      "*.cmake.in",
      "taglib/",
      "bindings/",
      "build/taglib-build/",
      "build/*.sh",
      "build/*.cpp",
      "!build/taglib-wrapper.js",
      "!build/taglib-wrapper.d.ts",
      "!build/taglib-web.wasm",
      "!build/taglib-wasi.wasm",
      ".beads/",
      ".github/",
      ".vscode/",
      ".ai/",
      ".ast-grep/",
      "sgconfig.yml",
      "node_modules/",
      "dist/*",
      "!dist/taglib-wrapper.js",
      "*.log",
      "*.tgz",
      ".DS_Store",
      "tsconfig.json",
      "deno.lock",
      "mise.toml",
      "package.json",
      "package-lock.json",
      "npm-shrinkwrap.json",
      "DENO_COMPATIBILITY_FIX.md",
      "CODEC_DETECTION.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-unused-vars",
        "require-await"
      ]
    },
    "exclude": [
      "lib/",
      "build/",
      "scripts/",
      "examples/",
      "tools/",
      "docs/.vuepress/",
      "docs/index.html"
    ]
  },
  "fmt": {
    "exclude": [
      "lib/",
      "build/",
      "docs/.vuepress/",
      "docs/index.html",
      ".ast-grep/rule-tests/__snapshots__/"
    ],
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "test": {
    "exclude": [
      "tests/bun-integration.test.ts",
      "tests/cross-runtime/",
      "tests/_assert-helpers.test.ts",
      "tests/runtime-detector.test.ts",
      "tests/runtime-detector-unit.test.ts",
      "tests/unified-api.test.ts",
      "tests/unified-loader-components.test.ts",
      "tests/error-handling.test.ts",
      "tests/node-fs-acquisition.test.ts",
      "src/runtime/platform-io.test.ts",
      "tests/backend-adapter.ts",
      "tests/adts-label.test.ts",
      "tests/audio-properties.test.ts",
      "tests/auto-dispose.test.ts",
      "tests/backend-registration.test.ts",
      "tests/basic-tags.test.ts",
      "tests/checksum-input-contract.test.ts",
      "tests/cross-backend-parity.test.ts",
      "tests/date-roundtrip.test.ts",
      "tests/format-detection.test.ts",
      "tests/id3-format-detection.test.ts",
      "tests/input-validation.test.ts",
      "tests/integration-workflow.test.ts",
      "tests/media-checksum.test.ts",
      "tests/mp4-codec.test.ts",
      "tests/mp4-genre-precedence.test.ts",
      "tests/ogg-flavor-parity.test.ts",
      "tests/tag-roundtrip-property.test.ts",
      "tests/unicode-comprehensive.test.ts",
      "src/taglib/extra-state-registry.test.ts",
      "tests/bitrate-mode.test.ts",
      "tests/browser-entry-surface.test.ts",
      "tests/bwf-bext-codec.test.ts",
      "tests/bwf.test.ts",
      "tests/chapters.test.ts",
      "tests/check-publish-access.test.ts",
      "tests/constants.test.ts",
      "tests/disc-folder-entry.test.ts",
      "tests/id3v2-frames.test.ts",
      "tests/media-checksum-corpus.test.ts",
      "tests/media-ranges.test.ts",
      "tests/mp4-items.test.ts",
      "tests/opus-output-gain.test.ts",
      "tests/strip-id3-flac.test.ts",
      "src/msgpack/decoder.test.ts",
      "src/msgpack/encoder.test.ts",
      "src/taglib/id3v2-frames.test.ts",
      "src/taglib/load-audio-data.test.ts",
      "src/taglib/metadata-extent.test.ts",
      "src/utils/tag-mapping.test.ts",
      "tests/advisory.test.ts",
      "tests/album-grouping.test.ts",
      "tests/api-realignment.test.ts",
      "tests/arena-memory-safety.test.ts",
      "tests/asf-unknown-attributes.test.ts",
      "tests/audio-file-save.test.ts",
      "tests/bpm-fractional-write.test.ts",
      "tests/codec-detection.test.ts",
      "tests/compilation-parity.test.ts",
      "tests/edge-cases.test.ts",
      "tests/errors-utilities.test.ts",
      "tests/extended-metadata.test.ts",
      "tests/extended-write-roundtrip.test.ts",
      "tests/file-utils-unit.test.ts",
      "tests/folder-api.test.ts",
      "tests/format-narrowing.test.ts",
      "tests/heap-growth.test.ts",
      "tests/include-properties.test.ts",
      "tests/memory-management.test.ts",
      "tests/memory.test.ts",
      "tests/msgpack-codec-unit.test.ts",
      "tests/msgpack-properties.test.ts",
      "tests/msgpack.test.ts",
      "tests/msgpack-wire-compatibility.test.ts",
      "tests/multi-value-tags.test.ts",
      "tests/partial-loading.test.ts",
      "tests/picture-api.test.ts",
      "tests/property-raw-values.test.ts",
      "tests/r128-loudness.test.ts",
      "tests/rating-api.test.ts",
      "tests/rating.test.ts",
      "tests/read-aliases.test.ts",
      "tests/release-country.test.ts",
      "tests/release-type.test.ts",
      "tests/security.test.ts",
      "tests/simple-api-unit.test.ts",
      "tests/taglib-class-coverage.test.ts",
      "tests/taglib.test.ts",
      "tests/tag-operations-errors.test.ts",
      "tests/utils-unit.test.ts",
      "tests/wasi-adapter-unit.test.ts",
      "tests/wasi-host.test.ts",
      "tests/wasi-memory-raii.test.ts",
      "tests/wasi-path-io.test.ts",
      "tests/wasi-write-roundtrip.test.ts",
      "tests/web-utils-unit.test.ts",
      "tests/write-tags-batch.test.ts"
    ]
  },
  "tasks": {
    "build": "deno task build:ts && deno task build:wasm",
    "build:ts": "deno run -A scripts/build-js.mjs",
    "build:wasm": "deno task build:wasm:emscripten && deno task build:wasm:wasi",
    "build:wasm:emscripten": "cd build && bash build-wasm.sh",
    "build:wasm:wasi": "cd build && bash build-wasi.sh",
    "smoke:emscripten": "deno run --allow-read --allow-env scripts/smoke-emscripten.ts",
    "test": "deno test --allow-read --allow-write --allow-env --v8-flags=--expose-gc tests/ src/",
    "test:watch": "deno test --allow-read --allow-write --allow-env --v8-flags=--expose-gc --watch tests/",
    "test:unified": "deno test --allow-read --allow-write tests/unified-*.test.ts tests/runtime-*.test.ts tests/msgpack.test.ts tests/wasi-*.test.ts",
    "test:phase3": "deno test --allow-read --allow-write tests/unified-api.test.ts tests/unified-loader-components.test.ts tests/msgpack.test.ts tests/runtime-detector.test.ts",
    "dev": "deno run --watch --allow-read --allow-write examples/basic-usage.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "lint:ast": "bash -c 'command -v ast-grep >/dev/null 2>&1 || { echo \"⚠ ast-grep not installed — skipping structural rules (brew install ast-grep)\"; exit 0; }; ast-grep test && ast-grep scan'",
    "check": "deno check index.ts src/**/*.ts tests/**/*.ts",
    "check:all": "deno fmt --check && deno task lint && deno task lint:ast && deno task docs:coverage && deno task knip && deno task check && deno task test && deno task build:ts && bash scripts/check-toolchain-pins.sh",
    "knip": "npx --no-install knip --no-progress --no-config-hints",
    "docs:coverage": "deno run --allow-read --allow-run scripts/docs-coverage.ts",
    "version:patch": "deno run --allow-read --allow-write scripts/sync-version.ts patch",
    "version:minor": "deno run --allow-read --allow-write scripts/sync-version.ts minor",
    "version:major": "deno run --allow-read --allow-write scripts/sync-version.ts major",
    "version:set": "deno run --allow-read --allow-write scripts/sync-version.ts set",
    "version:check": "deno run --allow-read --allow-write scripts/sync-version.ts check",
    "bench": "deno bench --allow-read --allow-write --allow-env tests/wasi-vs-emscripten.bench.ts",
    "release": "./scripts/release-safe.sh",
    "release:quick": "./scripts/release-safe.sh --skip-watch"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@msgpack/msgpack": "npm:@msgpack/msgpack@^3.1.3",
    "fast-check": "npm:fast-check@^4.10.1"
  }
}
