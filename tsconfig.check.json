{
  // Tests-inclusive type-check config. `deno check ./src ./tests` covered the
  // test files; tsconfig.json is the npm package build config and excludes them,
  // so this config keeps that coverage after the toolchain flip.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    // tsconfig.json sets declarationMap: true; TS5069 rejects a declaration map
    // without `declaration` (or `composite`), so this override is required.
    "declarationMap": false,
    // TS switch to target ES2022 for the package build, but the tests run on
    // Node 24 (Deno's check ran with the ESNext lib via `deno.window`), and
    // tests/auto-dispose.test.ts uses Promise.withResolvers (ES2024,
    // TS2550 under ES2022). Widen the lib for the check only; the build
    // config is untouched.
    "lib": ["ESNext", "DOM", "ESNext.Disposable"]
  },
  "include": ["index.ts", "src/**/*", "tests/**/*", "*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "build",
    "examples",
    // Deno-only files: tests/wasi-vs-emscripten.bench.ts and
    // tests/test-files/_gen/make-bwf-fixtures.ts use the `Deno` namespace
    // and/or JSR (`@std/*`) specifiers, which tsc cannot resolve. After the
    // Deno test gate was retired they are on no gate at all; they stay listed
    // here until phase 3 deletes deno.json. Listing them is not a way to hide
    // a type error in code that Node executes.
    "tests/wasi-vs-emscripten.bench.ts",
    "tests/test-files/_gen/make-bwf-fixtures.ts"
  ]
}
