{
  "name": "taglib-wasm",
  "version": "2.3.2",
  "description": "TagLib-Wasm is the universal tagging library for TypeScript/JavaScript platforms: Browsers, Node.js, Deno, Bun, Cloudflare Workers, and Electron apps",
  "keywords": [
    "acoustid",
    "audio",
    "browser",
    "bun",
    "cloudflare",
    "deno",
    "electron",
    "flac",
    "metadata",
    "mp3",
    "mp4",
    "musicbrainz",
    "node",
    "replaygain",
    "taglib",
    "typescript",
    "wasm",
    "webassembly",
    "workers"
  ],
  "homepage": "https://github.com/CharlesWiltgen/TagLib-Wasm#readme",
  "bugs": {
    "url": "https://github.com/CharlesWiltgen/TagLib-Wasm/issues"
  },
  "license": "MIT",
  "author": "Charles Wiltgen <cwiltgen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlesWiltgen/TagLib-Wasm.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "browser": "./dist/index.browser.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "simple": [
        "dist/simple.d.ts"
      ],
      "folder": [
        "dist/folder.d.ts"
      ],
      "disc-folder": [
        "dist/disc-folder.d.ts"
      ],
      "web": [
        "dist/web.d.ts"
      ],
      "rating": [
        "dist/rating.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./simple": {
      "browser": {
        "types": "./dist/simple.browser.d.ts",
        "default": "./dist/simple.browser.js"
      },
      "default": {
        "types": "./dist/simple.d.ts",
        "default": "./dist/simple.js"
      }
    },
    "./folder": {
      "types": "./dist/folder.d.ts",
      "default": "./dist/folder.js"
    },
    "./disc-folder": {
      "types": "./dist/disc-folder.d.ts",
      "default": "./dist/disc-folder.js"
    },
    "./web": {
      "browser": {
        "types": "./dist/web.browser.d.ts",
        "default": "./dist/web.browser.js"
      },
      "default": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
    },
    "./rating": {
      "types": "./dist/rating.d.ts",
      "default": "./dist/rating.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:wasm": "npm run build:wasm:emscripten && npm run build:wasm:wasi",
    "build:wasm:emscripten": "./build/build-wasm.sh",
    "build:wasm:wasi": "./build/build-wasi.sh",
    "build:ts": "tsc && npm run build:js",
    "postbuild": "node scripts/postbuild.mjs",
    "build:copy-wasm": "mkdir -p dist && cp build/taglib-web.wasm build/taglib-wasi.wasm build/taglib-wrapper.js build/taglib-wrapper.d.ts dist/",
    "build:clean": "mkdir -p dist && find dist -mindepth 1 -maxdepth 1 ! -name wasi -exec rm -rf {} +",
    "build": "npm run build:clean && npm run build:wasm:emscripten && npm run build:copy-wasm && npm run build:ts && npm run postbuild",
    "build:js": "vp pack",
    "build:release": "npm run build:js && npm run build:wasm",
    "docs:coverage": "npx tsx scripts/docs-coverage.ts",
    "knip": "npx --no-install knip --no-progress --treat-config-hints-as-errors",
    "smoke:emscripten": "npx tsx scripts/smoke-emscripten.ts",
    "smoke:wasi": "npx tsx scripts/smoke-wasi.ts",
    "bench": "npx tsx tests/wasi-vs-emscripten.bench.ts",
    "version:patch": "npx tsx scripts/sync-version.ts patch",
    "version:minor": "npx tsx scripts/sync-version.ts minor",
    "version:major": "npx tsx scripts/sync-version.ts major",
    "version:set": "npx tsx scripts/sync-version.ts set",
    "version:check": "npx tsx scripts/sync-version.ts check",
    "lint:ast": "bash -c 'command -v ast-grep >/dev/null 2>&1 || { echo \"ast-grep not installed — skipping structural rules\"; exit 0; }; ast-grep test && ast-grep scan'",
    "test:sonar": "SONAR_REPORT=1 vp test --coverage",
    "check:all": "npx vp check && npm run lint:ast && npm run docs:coverage && npm run knip && npm run knip:strict && npx tsc --noEmit -p tsconfig.check.json && npx vp test && npm run build:js && npm run postbuild && node scripts/check-dist-resolution.mjs && node scripts/check-disc-folder.mjs && bash scripts/check-toolchain-pins.sh",
    "test": "vp test",
    "test:bun": "bun test tests/bun-integration.test.ts",
    "test:deno": "deno test --allow-read --allow-write --allow-env tests/deno-*.test.ts",
    "test:cross-runtime": "./tests/cross-runtime/run.sh",
    "test:watch": "vp test --watch",
    "test:coverage": "vp test --coverage",
    "test:package": "./scripts/test-npm-package.sh",
    "docs:dev": "cd docs && npm install && npm run dev",
    "docs:build": "cd docs && npm install && npm run build",
    "update-taglib": "./scripts/update-taglib.sh",
    "release": "./scripts/release-safe.sh",
    "release:quick": "./scripts/release-safe.sh --skip-watch",
    "knip:strict": "npx --no-install knip --no-progress --strict --no-tag-hints",
    "verify:published": "node scripts/verify-published.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "^4.10.1",
    "knip": "^6.36.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-plus": "1.1.0",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "knip": {
    "entry": [
      "src/{index,index.browser,simple,simple.browser,folder,disc-folder,web,web.browser,rating}.ts!",
      "src/taglib/index.ts!",
      "src/msgpack/index.ts!",
      "src/types/index.ts!",
      "src/runtime/unified-loader/index.ts!",
      "tests/**/*.test.ts",
      "tests/**/*.bench.ts",
      "src/**/*.test.ts!",
      "tests/cross-runtime/**/*.ts",
      "tests/test-files/_gen/make-bwf-fixtures.ts",
      "scripts/**/*.{ts,mjs,js}"
    ],
    "project": [
      "src/**/*.ts!",
      "tests/**/*.ts",
      "scripts/**/*.{ts,mjs,js}",
      "*.ts"
    ],
    "ignoreDependencies": [
      "vitest-sonar-reporter"
    ],
    "ignoreExportsUsedInFile": true,
    "ignoreIssues": {
      "src/file-utils/index.ts": [
        "exports",
        "types"
      ],
      "src/constants/properties.ts": [
        "exports",
        "types"
      ],
      "src/folder-api/types.ts": [
        "exports",
        "types"
      ]
    }
  }
}
