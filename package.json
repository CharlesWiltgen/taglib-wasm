{
  "name": "taglib-wasm",
  "version": "2.3.0",
  "description": "TagLib-Wasm is the universal tagging library for TypeScript/JavaScript platforms: Browsers, Node.js, Bun, Cloudflare Workers, and Electron apps",
  "keywords": [
    "acoustid",
    "audio",
    "browser",
    "bun",
    "cloudflare",
    "electron",
    "flac",
    "metadata",
    "mp3",
    "mp4",
    "musicbrainz",
    "node",
    "replaygain",
    "taglib",
    "typescript",
    "wasm",
    "webassembly",
    "workers"
  ],
  "homepage": "https://github.com/CharlesWiltgen/TagLib-Wasm#readme",
  "bugs": {
    "url": "https://github.com/CharlesWiltgen/TagLib-Wasm/issues"
  },
  "license": "MIT",
  "author": "Charles Wiltgen <cwiltgen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlesWiltgen/TagLib-Wasm.git"
  },
  "files": [
    "dist/**/*",
    "!dist/poc",
    "index.ts",
    "index.browser.ts",
    "simple.ts",
    "simple.browser.ts",
    "folder.ts",
    "disc-folder.ts",
    "web.ts",
    "web.browser.ts",
    "rating.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "browser": "./dist/index.browser.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "simple": [
        "dist/simple.d.ts"
      ],
      "folder": [
        "dist/folder.d.ts"
      ],
      "disc-folder": [
        "dist/disc-folder.d.ts"
      ],
      "web": [
        "dist/web.d.ts"
      ],
      "rating": [
        "dist/rating.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./simple": {
      "browser": {
        "types": "./dist/simple.browser.d.ts",
        "default": "./dist/simple.browser.js"
      },
      "default": {
        "types": "./dist/simple.d.ts",
        "default": "./dist/simple.js"
      }
    },
    "./folder": {
      "types": "./dist/folder.d.ts",
      "default": "./dist/folder.js"
    },
    "./disc-folder": {
      "types": "./dist/disc-folder.d.ts",
      "default": "./dist/disc-folder.js"
    },
    "./web": {
      "browser": {
        "types": "./dist/web.browser.d.ts",
        "default": "./dist/web.browser.js"
      },
      "default": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
    },
    "./rating": {
      "types": "./dist/rating.d.ts",
      "default": "./dist/rating.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:wasm": "npm run build:wasm:emscripten && npm run build:wasm:wasi",
    "build:wasm:emscripten": "./build/build-wasm.sh",
    "build:wasm:wasi": "./build/build-wasi.sh",
    "build:ts": "tsc && deno run --allow-read --allow-write --allow-run --allow-env scripts/build-js.mjs",
    "postbuild": "deno run --allow-read --allow-write --allow-run --allow-env scripts/postbuild.mjs",
    "build:copy-wasm": "mkdir -p dist && cp build/taglib-web.wasm build/taglib-wasi.wasm build/taglib-wrapper.js build/taglib-wrapper.d.ts dist/",
    "build:clean": "mkdir -p dist && find dist -mindepth 1 -maxdepth 1 ! -name wasi -exec rm -rf {} +",
    "build": "npm run build:clean && npm run build:wasm:emscripten && npm run build:copy-wasm && npm run build:ts && npm run postbuild",
    "build:js": "node scripts/build-js.mjs",
    "build:release": "npm run build:js && npm run build:wasm",
    "docs:coverage": "npx tsx scripts/docs-coverage.ts",
    "knip": "npx --no-install knip --no-progress --no-config-hints",
    "smoke:emscripten": "npx tsx scripts/smoke-emscripten.ts",
    "smoke:wasi": "npx tsx scripts/smoke-wasi.ts",
    "bench": "npx tsx tests/wasi-vs-emscripten.bench.ts",
    "test:sonar": "SONAR_REPORT=1 vp test --coverage",
    "test": "vp test",
    "test:core": "vp test tests/taglib.test.ts",
    "test:pictures": "vp test tests/picture-api.test.ts",
    "test:edge": "vp test tests/edge-cases.test.ts",
    "test:errors": "vp test tests/error-handling.test.ts",
    "test:memory": "vp test tests/memory.test.ts",
    "test:extended": "vp test tests/extended-metadata.test.ts",
    "test:bun": "bun test tests/bun-integration.test.ts",
    "test:cross-runtime": "./tests/cross-runtime/run.sh",
    "test:watch": "vp test --watch",
    "test:coverage": "vp test --coverage",
    "test:package": "./scripts/test-npm-package.sh",
    "docs:dev": "cd docs && npm install && npm run dev",
    "docs:build": "cd docs && npm install && npm run build",
    "update-taglib": "./scripts/update-taglib.sh",
    "release": "./scripts/release-safe.sh",
    "release:quick": "./scripts/release-safe.sh --skip-watch",
    "publish:npm": "echo 'Use GitHub Actions workflow for publishing'",
    "publish:github": "echo 'Use GitHub Actions workflow for publishing'",
    "fmt:vp": "vp fmt",
    "lint:vp": "vp lint --type-aware",
    "test:vp": "vp test",
    "check:vp": "tsc --noEmit -p tsconfig.check.json && vp lint --type-aware"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.1",
    "knip": "^6.36.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-plus": "1.1.0",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0"
}
