{
  "name": "@charlesw/taglib-wasm",
  "version": "2.4.0",
  "description": "TagLib-Wasm is the universal tagging library for TypeScript/JavaScript platforms: Browsers, Node.js, Deno, Bun, Cloudflare Workers, and Electron apps",
  "license": "MIT",
  "nodeModulesDir": "none",
  "exports": {
    ".": "./src/index.ts",
    "./simple": "./src/simple.ts",
    "./folder": "./src/folder.ts",
    "./disc-folder": "./src/disc-folder.ts",
    "./web": "./src/web.ts",
    "./rating": "./src/rating.ts"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "AGENTS.md",
      "CHANGELOG.md",
      "coverage/",
      "dist/*",
      "!dist/taglib-wrapper.js",
      "docs/",
      "examples/",
      "lib/",
      "node_modules/",
      "scripts/",
      "tests/",
      "tools/",
      "build/*.sh",
      "build/*.cpp",
      "!build/taglib-wrapper.js",
      "!build/taglib-wrapper.d.ts",
      "!build/taglib-web.wasm",
      "!build/taglib-wasi.wasm",
      "build/dist/",
      "build/emscripten/",
      "build/emsdk/",
      "build/poc/",
      "build/taglib-build/",
      "build/tests/",
      "build/wasi/",
      "build/wasi-full/",
      "build/wasi-sdk/",
      ".ast-grep/",
      ".beads/",
      ".claude/",
      ".conductor/",
      ".github/",
      ".githooks/",
      ".omp/",
      ".serena/",
      ".superpowers/",
      ".vscode/",
      ".worktrees/",
      "sgconfig.yml",
      "sonar-project.properties",
      "tsconfig.json",
      "tsconfig.check.json",
      "vite.config.ts",
      "mise.toml",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "junit.xml",
      "*.log",
      "*.tgz",
      ".DS_Store",
      ".gitattributes",
      ".gitmodules",
      ".git-blame-ignore-revs"
    ]
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true,
    "exactOptionalPropertyTypes": true
  }
}
