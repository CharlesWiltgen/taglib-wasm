{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/taglib/index.ts",
    "src/msgpack/index.ts",
    "src/types/index.ts",
    "src/runtime/unified-loader/index.ts",
    "tests/**/*.test.ts",
    "tests/**/*.bench.ts",
    "tests/test-files/_gen/make-bwf-fixtures.ts",
    "scripts/**/*.{ts,mjs,js}"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.{ts,mjs,js}",
    "*.ts"
  ],
  "ignoreDependencies": [
    "@std/.*",
    "npm"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/file-utils/index.ts": [
      "exports",
      "types"
    ],
    "src/constants/properties.ts": [
      "exports",
      "types"
    ],
    "src/folder-api/types.ts": [
      "exports",
      "types"
    ],
    "scripts/build-js.mjs": [
      "unresolved"
    ]
  }
}
